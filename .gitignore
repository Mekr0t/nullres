.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Cached market data — reproducible via `nullres fetch`, do not commit.
# The leading slash anchors these to the repo root. Without it, git matches the
# pattern at ANY depth: a bare `data/` also excluded `nullres/data/`, quietly
# keeping three source files out of every commit until CI failed on them.
/data/
!/data/.gitkeep

# Ad-hoc run outputs (regenerated by --save)
/reports/
*.joblib

# NOTE: `runs/` is deliberately NOT ignored. It is the append-only evidence
# ledger behind docs/05-graveyard.md — the record of what was measured, under
# which config, at which commit. Committing it is the point: it is what lets a
# future run warn "you already killed this", and what makes the graveyard's
# numbers reproducible rather than remembered.

# Built documentation. `mkdocs build` regenerates it; `mkdocs serve` previews
# it live. The sources are docs/ plus the docstrings themselves.
/site/
